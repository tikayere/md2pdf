    "commander": "^11.1.0",
    "glob": "^10.5.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.2.0",
    "marked": "^12.0.2",
    "marked-gfm-heading-id": "^3.2.0",
    "puppeteer": "^21.11.0"
  }
