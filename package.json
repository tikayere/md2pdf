{
  "name": "md2pdf-book",
  "version": "2.1.0",
  "description": "Professional Markdown → PDF book converter with YAML config, LaTeX, and Mermaid support",
  "type": "module",
  "license": "MIT",
  "author": "POUROU Tikayere Dominique",
  "homepage": "https://github.com/tikayere/md2pdf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tikayere/md2pdf.git"
  },
  "bugs": {
    "url": "https://github.com/tikayere/md2pdf/issues"
  },
  "keywords": [
    "markdown",
    "pdf",
    "book",
    "ebook",
    "cli",
    "latex",
    "katex",
    "mermaid",
    "yaml",
    "typeset",
    "converter",
    "puppeteer",
    "pagedjs"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "md2pdf": "./bin/md2pdf.js",
    "md2pdf-book": "./bin/md2pdf.js"
  },
  "scripts": {
    "start": "node bin/md2pdf.js",
    "test": "node bin/md2pdf.js examples/book.yaml -v",
    "lint:example": "node bin/md2pdf.js examples/book.yaml --lint"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^11.1.0",
    "glob": "^10.5.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.2.0",
    "marked": "^12.0.2",
    "marked-gfm-heading-id": "^3.2.0",
    "puppeteer": "^21.11.0"
  }
}
